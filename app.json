{
  "expo": {
    "name": "Where To Park",
    "slug": "where-to-park",
    "owner": "the-bad-company",
    "version": "1.0.18",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "wheretopark",
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      "expo-location",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "./plugins/withOptionalPortraitFeature.js",
      [
        "expo-image-picker",
        {
          "photosPermission": "Where To Park uses photos for listing covers and chat messages."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2563eb"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0047A0"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3932328959688671~3884874189",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thebadcompany.wheretopark",
      "associatedDomains": ["applinks:where-to-park.expo.app"]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0047A0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.thebadcompany.wheretopark",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "where-to-park.expo.app",
              "path": "/"
            },
            {
              "scheme": "https",
              "host": "where-to-park.expo.app",
              "pathPrefix": "/search"
            },
            {
              "scheme": "https",
              "host": "where-to-park.expo.app",
              "pathPrefix": "/location"
            },
            {
              "scheme": "https",
              "host": "where-to-park.expo.app",
              "pathPrefix": "/auth"
            },
            {
              "scheme": "https",
              "host": "where-to-park.expo.app",
              "pathPrefix": "/privacy"
            },
            {
              "scheme": "https",
              "host": "where-to-park.expo.app",
              "pathPrefix": "/contact"
            },
            {
              "scheme": "https",
              "host": "where-to-park.expo.app",
              "pathPrefix": "/profile"
            },
            {
              "scheme": "https",
              "host": "where-to-park.expo.app",
              "pathPrefix": "/accounts"
            },
            {
              "scheme": "https",
              "host": "where-to-park.expo.app",
              "pathPrefix": "/vehicles"
            },
            {
              "scheme": "https",
              "host": "where-to-park.expo.app",
              "pathPrefix": "/shortcuts"
            },
            {
              "scheme": "https",
              "host": "where-to-park.expo.app",
              "pathPrefix": "/notifications"
            },
            {
              "scheme": "https",
              "host": "where-to-park.expo.app",
              "pathPrefix": "/sessions"
            },
            {
              "scheme": "https",
              "host": "where-to-park.expo.app",
              "pathPrefix": "/reserve"
            },
            {
              "scheme": "https",
              "host": "where-to-park.expo.app",
              "pathPrefix": "/chat"
            },
            {
              "scheme": "https",
              "host": "where-to-park.expo.app",
              "pathPrefix": "/operator"
            },
            {
              "scheme": "https",
              "host": "where-to-park.expo.app",
              "pathPrefix": "/staff"
            },
            {
              "scheme": "https",
              "host": "where-to-park.expo.app",
              "pathPrefix": "/admin"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "com.google.android.gms.permission.AD_ID"
      ],
      "versionCode": 19
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "811e8d6d-6c98-4307-9cca-f82f0c767a1a"
      }
    }
  }
}
