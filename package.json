{
  "name": "where-to-park",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:unit": "node --experimental-strip-types --test src/lib/*.test.ts src/components/map/*.test.ts src/lib/geocoding/*.test.ts",
    "test:db": "./scripts/test-db.sh",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "./scripts/reset-local-db.sh",
    "dev:proxy": "node scripts/local-api-proxy.js",
    "db:migrate": "supabase db push",
    "functions:serve": "supabase functions serve"
  },
  "dependencies": {
    "@expo/metro-runtime": "^58.0.15",
    "@gorhom/bottom-sheet": "^4.6.1",
    "@maplibre/maplibre-react-native": "^10.4.2",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "@react-navigation/native": "^6.1.9",
    "@supabase/supabase-js": "^2.39.0",
    "expo": "~50.0.0",
    "expo-auth-session": "~5.4.0",
    "expo-constants": "~15.4.0",
    "expo-crypto": "~12.8.0",
    "expo-dev-client": "~3.3.0",
    "expo-file-system": "~16.0.0",
    "expo-font": "~11.10.0",
    "expo-image": "~1.10.0",
    "expo-image-manipulator": "~11.8.0",
    "expo-image-picker": "~14.7.0",
    "expo-linking": "~6.2.0",
    "expo-location": "~16.5.0",
    "expo-notifications": "~0.27.0",
    "expo-router": "~3.4.0",
    "expo-secure-store": "~12.8.0",
    "expo-status-bar": "~1.11.0",
    "expo-web-browser": "~12.8.0",
    "maplibre-gl": "^4.7.1",
    "react": "18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "0.73.0",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-reanimated": "~3.6.0",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0",
    "react-native-svg": "14.1.0",
    "react-native-web": "^0.19.13",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@types/jest": "^29.5.11",
    "@types/react": "~18.2.45",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "eslint-config-expo": "^7.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "puppeteer": "^25.16.0",
    "typescript": "^5.3.3"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "exclude": [
        "@expo/dom-webview",
        "@expo/log-box"
      ]
    }
  }
}
